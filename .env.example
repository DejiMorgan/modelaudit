# Example only. Copy to backend/.env for your notes if desired, but note:
# the application reads process environment variables; it does not auto-load .env files.
# Do NOT commit secrets. For local development, export variables in your shell.

# SQLite location (optional; default is local project database)
# MODELAUDIT_DATABASE_URL=sqlite:////absolute/path/to/modelaudit.sqlite3

# OpenAI-compatible endpoint (optional; incurs provider charges)
MODELAUDIT_OPENAI_API_KEY=
MODELAUDIT_OPENAI_MODEL=
MODELAUDIT_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Messages API (optional; incurs provider charges)
MODELAUDIT_ANTHROPIC_API_KEY=
MODELAUDIT_ANTHROPIC_MODEL=
